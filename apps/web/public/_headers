# Served by Cloudflare with the static assets (next.config.ts cannot set
# headers on an export). The policy is as tight as the site is today; the PR
# that adds a mail source or a model widens connect-src to that host and no
# further. script-src needs 'unsafe-inline' for Next's inline bootstrap and
# the theme script; there is no third-party script to allow.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
